# =====================================================================
# Parking Spotter — secret configuration TEMPLATE
# ---------------------------------------------------------------------
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# The real ".env" is gitignored and MUST NEVER be committed.
# Only this template (.env.example) belongs in the repository.
# =====================================================================

# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-with-real-token

# Recorder (Dahua XVR "Ev") — use the STATIC IP you pinned (plan §9)
NVR_IP=192.168.1.5

# RTSP credentials for the recorder
RTSP_USER=admin
RTSP_PASS=replace-with-real-password

# Only this Telegram chat id may use the bot (it streams views of the house).
# To find it: message the bot, then check the logs — unauthorized chat ids are
# logged. Or use @userinfobot.
ALLOWED_CHAT_ID=123456789

# Local ollama vision model endpoint (spot verification / accuracy audit).
# In Docker, ollama runs on the host: use host.docker.internal.
# For a bare (non-Docker) run, use http://localhost:11434.
OLLAMA_URL=http://host.docker.internal:11434

# Optional: Uptime Kuma "Push" monitor URL (contains a token, so it lives here, not in config.yaml).
# The bot calls it every 60 s while its watch loop is healthy.
# HEARTBEAT_URL=http://localhost:3001/api/push/XXXXXXXX
